{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodal",
  "version": "0.3.0",
  "identifier": "dev.nodal.linewright",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @linewright/web dev",
    "beforeBuildCommand": "pnpm --filter @linewright/web build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Nodal — Transit map editor",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "licenseFile": "../../LICENSE",
    "category": "Graphics"
  }
}
