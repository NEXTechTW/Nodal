{
  "name": "linewright",
  "version": "0.3.0",
  "private": true,
  "description": "Browser-based transit map editor. Linewright is the monorepo; Nodal is the product.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @linewright/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @linewright/web preview",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,html}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  }
}
